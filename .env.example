# Copy this file to .env and fill only the providers you use.

# Optional provider selector. CLI --provider still takes precedence.
ALLRIGHT_PROVIDER=deepseek

# Recommended default. DeepSeek uses its Anthropic-compatible endpoint.
ALLRIGHT_DEEPSEEK_API_BASE=https://api.deepseek.com/anthropic
ALLRIGHT_DEEPSEEK_API_KEY=
ALLRIGHT_DEEPSEEK_MODEL=deepseek-v4-pro

# Optional right.codes shared key. Used by --provider openai and --provider anthropic when provider-specific keys are empty.
ALLRIGHT_RIGHT_CODES_API_KEY=

# Default OpenAI-compatible endpoint. Change this if you use another /responses-compatible service.
ALLRIGHT_OPENAI_API_BASE=https://www.right.codes/codex/v1
ALLRIGHT_OPENAI_API_KEY=
ALLRIGHT_OPENAI_MODEL=gpt-5.4

# Default Anthropic-compatible endpoint. Can reuse ALLRIGHT_RIGHT_CODES_API_KEY when your gateway shares one key.
ALLRIGHT_ANTHROPIC_API_BASE=https://www.right.codes/claude/v1
ALLRIGHT_ANTHROPIC_API_KEY=
ALLRIGHT_ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional comma-separated extra env names to redact from traces and reports.
ALLRIGHT_SECRET_ENV_NAMES=
